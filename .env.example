# Copy to .env and fill in your own values. The .env file is git-ignored.
#
# NUXT_LLM_BASE_URL  OpenAI-compatible gateway base URL (must end in /v1).
#                    Never point this at the app itself.
#                    Local setup: gateway on 3000, this app on 4000, e.g.
#                    NUXT_LLM_BASE_URL=http://localhost:3000/v1
# NUXT_LLM_API_KEY   API key for that gateway (empty = template-only mode).
# NUXT_LLM_MODEL     Model name, e.g. deepseek-flash
# NUXT_LLM_TIMEOUT_MS  Request timeout in milliseconds.

NUXT_LLM_BASE_URL=https://api.deepseek.com/v1
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=deepseek-flash
NUXT_LLM_TIMEOUT_MS=20000

# ---- Optional: KataGo analysis engine (native MCTS search) ----
# Leave all three paths empty to keep the app in pure rule-engine + LLM mode.
# KataGo is a compiled binary with a neural-net weight file; see README.
# Use ABSOLUTE Windows paths with forward slashes.
# Recommended zero-config build: v1.18.1 ONNX DirectML (bundles DirectML.dll,
# no CUDA/cuDNN install needed). The v1.18.2 CUDA build needs CUDA 12.8 + cuDNN 9.8.
# NUXT_KATAGO_BINARY=C:/katago/directml/katago.exe
# NUXT_KATAGO_CONFIG=C:/katago/analysis-directml.cfg
# NUXT_KATAGO_MODEL=C:/katago/<weight>.bin.gz
# NUXT_KATAGO_HUMAN_MODEL=C:/katago/b18c384nbt-humanv0.bin.gz
#   Optional human SL net (v1.15.0 release, ~95 MB). When present the rank
#   selector uses official humanSLProfile + humanPolicy sampling. When absent,
#   ranks are approximated by visit budget + candidate sampling.
# NUXT_KATAGO_MAX_VISITS   Search budget per position (CPU: 100-300 is plenty).
# NUXT_KATAGO_TIMEOUT_MS   Per-query timeout in milliseconds.
# NUXT_KATAGO_OWNERSHIP_SIGN  0 = auto, 1 / -1 = force ownership colour direction.
# NUXT_KATAGO_WINRATE_AS_BLACK  Keep true when analysis.cfg sets
#                              reportAnalysisWinratesAs = BLACK.
NUXT_KATAGO_BINARY=
NUXT_KATAGO_CONFIG=
NUXT_KATAGO_MODEL=
NUXT_KATAGO_MAX_VISITS=200
NUXT_KATAGO_TIMEOUT_MS=25000
NUXT_KATAGO_OWNERSHIP_SIGN=0
NUXT_KATAGO_WINRATE_AS_BLACK=true
